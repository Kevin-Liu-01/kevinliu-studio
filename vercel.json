{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/(.+)/$", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "^/index(?:\\.html)?$", "status": 308, "headers": { "Location": "/" } },
    { "src": "^/(.+)\\.html$", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "^/en(?:/.*)?$", "status": 308, "headers": { "Location": "/" } },
    { "src": "^/sitemap\\.xml$", "status": 308, "headers": { "Location": "/sitemap-index.xml" } },
    { "src": "^/(kevin_liu_resume_25\\.pdf|projects\\.md)$", "status": 308, "headers": { "Location": "https://portfoliomon.kevinliu.studio/$1" } },

    { "src": "^/.*$", "continue": true, "headers": {
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
      "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
      "Content-Security-Policy": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
    } },
    { "src": "^/(?:(?:es|fr|de|pt|ja|ko|zh)(?:/(?=.)|$))?(?:about|cards|battle|battle/arena|cards/[\\w-]+)?$", "continue": true, "headers": { "Vary": "Accept" } },
    { "src": "^/index\\.md$", "continue": true, "headers": { "Link": "<https://www.kevinliu.studio/>; rel=\"canonical\"" } },
    { "src": "^/((?:about|cards|battle|battle/arena|cards/[\\w-]+))\\.md$", "continue": true, "headers": { "Link": "<https://www.kevinliu.studio/$1>; rel=\"canonical\"" } },
    { "src": "^/(es|fr|de|pt|ja|ko|zh)/index\\.md$", "continue": true, "headers": { "Link": "<https://www.kevinliu.studio/$1>; rel=\"canonical\"" } },
    { "src": "^/((?:es|fr|de|pt|ja|ko|zh)/(?:about|cards|battle|battle/arena|cards/[\\w-]+))\\.md$", "continue": true, "headers": { "Link": "<https://www.kevinliu.studio/$1>; rel=\"canonical\"" } },
    { "src": "^/(?:(?:es|fr|de|pt|ja|ko|zh)/)?(?:llms|llms-full)\\.txt$", "continue": true, "headers": { "Content-Type": "text/plain; charset=utf-8" } },
    { "src": "^/_astro/.*$", "continue": true, "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "^/fonts/.*$", "has": [{ "type": "query", "key": "v" }], "continue": true, "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "^/(?:ex|sound|battle)/.*\\.(?:css|js)$", "has": [{ "type": "query", "key": "v" }], "continue": true, "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "^/(?:es|fr|de|pt|ja|ko|zh)/(?:gallery|battle-strings)\\.js$", "has": [{ "type": "query", "key": "v" }], "continue": true, "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "^/(?!ex/(?:borders|fx)/.*\\.svg$)(?:ex|battle|sound|og|share)/.*\\.(?:webp|avif|png|jpg|svg|mp4|webm|m4a|woff2)$", "continue": true, "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" } },
    { "src": "^/ex/(?:borders|fx)/.*\\.svg$", "missing": [{ "type": "query", "key": "v" }], "continue": true, "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" } },
    { "src": "^/ex/(?:borders|fx)/.*\\.svg$", "has": [{ "type": "query", "key": "v" }], "continue": true, "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },

    { "src": "^/$", "has": [{ "type": "header", "key": "accept", "value": "^(?:(?!text/html).)*text/markdown(?!\\s*;\\s*q=0(?:\\.0*)?\\s*(?:,|$)).*$" }], "dest": "/index.md" },
    { "src": "^/(about|cards|battle|battle/arena|cards/[\\w-]+)$", "has": [{ "type": "header", "key": "accept", "value": "^(?:(?!text/html).)*text/markdown(?!\\s*;\\s*q=0(?:\\.0*)?\\s*(?:,|$)).*$" }], "dest": "/$1.md" },
    { "src": "^/(es|fr|de|pt|ja|ko|zh)$", "has": [{ "type": "header", "key": "accept", "value": "^(?:(?!text/html).)*text/markdown(?!\\s*;\\s*q=0(?:\\.0*)?\\s*(?:,|$)).*$" }], "dest": "/$1/index.md" },
    { "src": "^/((?:es|fr|de|pt|ja|ko|zh)/(?:about|cards|battle|battle/arena|cards/[\\w-]+))$", "has": [{ "type": "header", "key": "accept", "value": "^(?:(?!text/html).)*text/markdown(?!\\s*;\\s*q=0(?:\\.0*)?\\s*(?:,|$)).*$" }], "dest": "/$1.md" },
    { "src": "^/(es|fr|de|pt|ja|ko|zh)$", "dest": "/$1.html" },

    { "handle": "filesystem" },
    { "src": "^/(.+)$", "dest": "/$1.html", "check": true },
    { "src": "^/(es|fr|de|pt|ja|ko|zh)/.*$", "status": 404, "dest": "/$1/404.html" },
    { "src": "^/.*$", "status": 404, "dest": "/404.html" }
  ]
}
