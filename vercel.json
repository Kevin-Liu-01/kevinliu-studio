{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/(.+)/$", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "^/(?:index|cards)(?:\\.html)?$", "status": 308, "headers": { "Location": "/" } },
    { "src": "^/(.+)\\.html$", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "^/en(?:/.*)?$", "status": 308, "headers": { "Location": "/" } },
    { "src": "^/(kevin_liu_resume_25\\.pdf|projects\\.md)$", "status": 308, "headers": { "Location": "https://portfoliomon.kevinliu.studio/$1" } },

    { "src": "^/.*$", "continue": true, "headers": {
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
      "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
      "Vary": "Accept"
    } },
    { "src": "^/.*\\.md$", "continue": true, "headers": { "Content-Type": "text/markdown; charset=utf-8" } },
    { "src": "^/(?:llms|llms-full)\\.txt$", "continue": true, "headers": { "Content-Type": "text/plain; charset=utf-8" } },
    { "src": "^/(?:_astro|fonts)/.*$", "continue": true, "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "^/(?:ex|battle|sound|og)/.*\\.(?:webp|avif|png|jpg|svg|mp4|webm|m4a|woff2)$", "continue": true, "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" } },

    { "src": "^/$", "has": [{ "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }], "dest": "/index.md" },
    { "src": "^/(about|battle|battle/arena|cards/[\\w-]+)$", "has": [{ "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }], "dest": "/$1.md" },

    { "handle": "filesystem" },
    { "src": "^/(.+)$", "dest": "/$1.html", "check": true },
    { "src": "^/.*$", "status": 404, "dest": "/404.html" }
  ]
}
