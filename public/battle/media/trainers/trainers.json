 "method": {
  "build": ".work/sprites/build.py, then .work/sprites/write-json.py; proof by .work/sprites/proof.py; grid search by .work/sprites/grid-receipt.py",
  "grid": "No sheet carries a native pixel grid: the comb strength of edge energy peaks at 0.0132 to 0.0832 on the sheets (plus a 2.0 px resampling alias), against 0.5085 to 0.5564 for a real grid (the native atlas enlarged back to the sheet). The native size is therefore the contract: 96x128 cells, figures at scale 0.30 of the sheet (the Landing's measured scale; the largest uniform scale that fits every pose on the shared anchor with a 1 px gutter is 0.2435).",
  "segment": "components of alpha >= 40, each assigned to the pose whose Landing crop holds most of it; specks under 12 source px dropped",
  "clean": "at source resolution: alpha under 40 removed (haze); semi-transparent pixels (alpha under 224) that are not dark ink removed (the yellow and white matte); dark semi-transparent pixels kept as the outline; edge pixels farther than 0.08 OKLab from the trainer's 64-colour core palette eroded until none is left",
  "resample": "4x4 samples per native px; alpha = coverage >= 0.5; colour line aware (ink where dark samples fill half the footprint, a quarter at a local maximum across the line, or an eighth on the silhouette edge, else the opaque material), then requantized to the palette",
  "anchor": "foot = middle of the main figure's lowest 51 source rows, ground = its lowest row + 1; placed at (48, 116) unless a wide gesture would cross the gutter, then shifted the least whole px (listed in receipt.shifted)"
 },
