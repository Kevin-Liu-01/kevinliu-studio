---
// The one page frame. A room page (home, a card) prints cards: it serves the card system's sheets from /ex/ and sets
// <base href="/ex/"> so every relative path the rounds' code writes (media/, posters/, borders/) resolves as authored.
// Every link this site writes is absolute for that reason.
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Release from '../components/Release.astro';
import { neuTokens, masks, sprite } from '../lib/cards';
import { versioned } from '../lib/assets';
import '../styles/site.css';
import '../styles/machine.css';

interface Props {
  seo: Parameters<typeof Seo>[0];
  room?: boolean;
  scripts?: string[]; // classic scripts under /ex/, in order (defer)
  html?: Record<string, string | boolean>;
  twinPath?: string;
  main?: string; // the id the skip link lands on
  heavy?: boolean; // gives back its GPU memory and pictures when it leaves on a touch screen (Release.astro)
}
const { seo, room = false, scripts = [], html = {}, twinPath = seo.path, main = 'main', heavy = false } = Astro.props;
// One face for every page, preloaded first and cached for a year. It blocks text rather than swapping (the cards'
// titles are fitted to its advances at build, markup.js ADV), and the fallback is Arial scaled to its width and line,
// so a page that ever paints before it arrives keeps every line where it was.
const FONT = '/fonts/katagami-sans-site.woff2';
const fontFace = [
  `@font-face{font-family:"Katagami Sans";src:url(${FONT}) format("woff2");font-weight:100 900;font-display:block}`,
  '@font-face{font-family:"Katagami Sans Fallback";src:local("Arial"),local("ArialMT");font-weight:100 600;size-adjust:106.9%;ascent-override:90.6%;descent-override:22.6%;line-gap-override:0%}',
  '@font-face{font-family:"Katagami Sans Fallback";src:local("Arial Bold"),local("Arial-BoldMT");font-weight:601 900;size-adjust:102%;ascent-override:95%;descent-override:23.6%;line-gap-override:0%}',
].join('');
---
<!doctype html>
<html lang="en" data-mode="human" {...html}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<link rel="preload" href={FONT} as="font" type="font/woff2" crossorigin />
{room && <base href="/ex/" />}
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#e9e4dc" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1d1a17" media="(prefers-color-scheme: dark)" />
<Seo {...seo} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<script is:inline>(function(){var d=document.documentElement,q=new URLSearchParams(location.search);try{if(localStorage.getItem('ill-mode')==='machine'){d.dataset.mode='machine';var l=document.createElement('link');l.rel='preload';l.as='font';l.type='font/woff2';l.crossOrigin='';l.href='/fonts/katagami-mono-site.woff2';document.head.append(l)}}catch(e){}var t=q.get('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');d.dataset.theme=t;try{if(localStorage.getItem('ill-pause')==='1'||matchMedia('(prefers-reduced-motion: reduce)').matches)d.dataset.paused=''}catch(e){}})()</script>
{heavy && <Release />}
<style is:inline id="kface" set:html={`${fontFace}\n${neuTokens}:root{--mask-win:${masks.win}}`}></style>
<link rel="stylesheet" href={versioned('/ex/ui.css')} />
{room && <link rel="stylesheet" href={versioned('/ex/card.css')} />}
{/* only a page that runs the rituals takes their sheet: it opts the page into cross-document View Transitions, which on
   a card page crossfaded every return to the wall through a pale frame */}
{scripts.includes('rituals.js') && <link rel="stylesheet" href={versioned('/ex/rituals.css')} />}
{scripts.map((s) => <script is:inline defer src={versioned(`/ex/${s}`)}></script>)}
<slot name="head" />
<Analytics />
</head>
<body>
<a class="skip" href={`${seo.path}#${main}`} data-to={main}>Skip to content</a>
<script is:inline>/* the skip link keeps the address as typed (query, unknown paths), so it never reloads */(function(a){a.href=location.pathname+location.search+"#"+a.dataset.to})(document.currentScript.previousElementSibling)</script>
{/* on a phone the header has no room for the Human and Machine switch, so the footer holds it; these give a keyboard the
   other view at the second stop, and show only while focused (machine.css) */}
<button type="button" class="skip skipmode" data-mode-set="machine" aria-pressed="false">Machine view</button>
<button type="button" class="skip skipmode" data-mode-set="human" aria-pressed="false">Human view</button>
<div class="human">
<div id="behind">
<Header path={seo.path} />
<slot />
<Footer path={twinPath} twin={seo.twin === undefined ? (seo.path === '/' ? '/index.md' : `${seo.path}.md`) : seo.twin} />
</div>
<slot name="overlay" />
</div>
<Fragment set:html={sprite} />
<slot name="foot" />
<script is:inline>/* Human and Machine on every page (gallery.js does the same on the home page; both write the same state). Focus stays on the header's switch, or else moves to the visible switch nearest the one pressed, so the page never jumps: in the Machine view a region's human form keeps its box but is hidden. fit() lets each machine form use its box and the empty room below it up to the next element, then shrinks its text until it fits (machine.css), so switching moves nothing; siblings of one kind (a list's items, a run of paragraphs, not headings) then share the smallest size any of them took; it runs on a switch, on a Machine load once the face is ready, when a face lands, and after a resize. The terminal face is fetched at idle after load, so a switch finds it ready */document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('[data-mode-set]');if(!b)return;var m=b.dataset.modeSet,d=document.documentElement,bt=b.getBoundingClientRect().top;d.dataset.mode=m;try{localStorage.setItem('ill-mode',m)}catch(_){}document.querySelectorAll('[data-mode-set]').forEach(function(x){x.setAttribute('aria-pressed',String(x.dataset.modeSet===m))});document.querySelectorAll('.seg').forEach(function(s){s.style.setProperty('--i',m==='machine'?1:0)});var v=[].filter.call(document.querySelectorAll('[data-mode-set]'),function(x){return x.checkVisibility?x.checkVisibility({visibilityProperty:true}):x.offsetParent!==null}),f=v.find(function(x){return x.dataset.modeSet===m&&x.closest('.seg')})||v.sort(function(x,y){return Math.abs(x.getBoundingClientRect().top-bt)-Math.abs(y.getBoundingClientRect().top-bt)})[0];if(f)f.focus();fit()});(function(){var m=document.documentElement.dataset.mode;if(m==='machine'){document.querySelectorAll('[data-mode-set]').forEach(function(x){x.setAttribute('aria-pressed',String(x.dataset.modeSet===m))});document.querySelectorAll('.seg').forEach(function(s){s.style.setProperty('--i',1)})}})();function fit(){var d=document.documentElement,floor=innerWidth<640?9:10;if(d.dataset.mode!=='machine')return;document.querySelectorAll('.sw > .mx, .sl > .mx, .fm, .rec').forEach(function(e){if(e.querySelector('details[open]'))return;e.style.fontSize='';e.style.bottom='';e.removeAttribute('data-over');if(!e.checkVisibility||!e.checkVisibility())return;var h=e.parentElement,n=null;if(h.classList.contains('sw')||h.classList.contains('sl'))for(var a=h;a&&a!==document.body&&!(n=a.nextElementSibling);a=a.parentElement);if(n){var hb=h.getBoundingClientRect().bottom,nt=n.getBoundingClientRect().top;if(nt>hb)e.style.bottom=(hb-nt)+'px'}var over=function(){return e.scrollHeight>e.clientHeight+1||e.scrollWidth>e.clientWidth+1},s=parseFloat(getComputedStyle(e).fontSize);while(over()&&s>floor){s-=0.5;e.style.fontSize=s+'px'}if(over())e.setAttribute('data-over','')});var g=new Map();document.querySelectorAll('.sw:not(.hw) > .mx').forEach(function(e){if(!e.checkVisibility())return;var h=e.parentElement,k=h.parentElement,t=h.tagName+'|'+h.className,m=g.get(k)||new Map();g.set(k,m);if(!m.has(t))m.set(t,[]);m.get(t).push(e)});g.forEach(function(m){m.forEach(function(es){if(es.length<2)return;var z=es.map(function(e){return parseFloat(getComputedStyle(e).fontSize)}),min=Math.min.apply(null,z);es.forEach(function(e,n){if(z[n]>min)e.style.fontSize=min+'px'})})})}if(document.documentElement.dataset.mode==='machine')(document.fonts?document.fonts.ready:Promise.resolve()).then(fit);else addEventListener('load',function(){(self.requestIdleCallback||setTimeout)(function(){try{document.fonts.load('700 1em "Katagami Mono"')}catch(e){}})},{once:true});if(document.fonts)document.fonts.addEventListener('loadingdone',fit);var rt=0;addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(fit,150)})</script>
</body>
</html>
