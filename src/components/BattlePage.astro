---
import Seo from './Seo.astro';
import Analytics from './Analytics.astro';
import Release from './Release.astro';
import { battlePage } from '../lib/battle';
import { graph, page } from '../lib/schema';
import { SITE, NAME, person } from '../lib/site';
import { L } from '../i18n';
import { versioned } from '../lib/assets';
import FACES from '../i18n/fonts.json';
import { battleStringsSrc } from '../lib/i18n-battle';
interface Props { mode: 'mat' | 'arena'; code?: string }
const { mode, code = 'en' } = Astro.props;
const l = L(code), t = l.t;
const path = l.p(mode === 'arena' ? '/battle/arena' : '/battle');
const title = t(mode === 'arena' ? 'battle.titleArena' : 'battle.title');
const description = t(mode === 'arena' ? 'battle.descriptionArena' : 'battle.description', { name: NAME });
const game = { '@type': 'VideoGame', '@id': `${SITE}${l.p('/battle')}#game`, name: t('battle.game', { name: NAME }), url: `${SITE}${l.p('/battle')}`, description: t('battle.gameDescription', { name: NAME }), genre: 'Card battle', playMode: 'SinglePlayer', gamePlatform: 'Web browser', applicationCategory: 'GameApplication', operatingSystem: 'Web browser', isAccessibleForFree: true, inLanguage: l.lang, image: `${SITE}/share/battle.jpg`, author: { '@id': person['@id'] }, creator: { '@id': person['@id'] } };
const share = mode === 'arena' ? 'arena' : 'battle';
const jsonld = graph(page({ path, type: 'WebPage', name: title, description, image: `${SITE}/share/${share}.jpg`, crumbs: mode === 'arena' ? [[t('battle.title'), l.p('/battle')], [t('battle.arena'), path]] : [[t('battle.title'), path]], mainEntity: { '@id': game['@id'] }, code }), game);
const alt = t(mode === 'arena' ? 'battle.altArena' : 'battle.alt');
// The battle in another language: the page's own frame (its rail, console keys, hints and log heading) speaks it; the
// game inside (turn prompts, move panels, tooltips, narration, cutscenes) is the rounds' r4/play and writes English
// until the rounds give it string tables. Each swap names markup that occurs once, so a changed round fails the build.
function localize(body: string) {
  if (l.en) return body;
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const pairs: [string, string][] = [
    ['<header class="rail" aria-label="Battle">', `<header class="rail" aria-label="${esc(t('battle.title'))}">`],
    ['<div class="team-rail" id="team" aria-label="Teams" hidden>', `<div class="team-rail" id="team" aria-label="${esc(t('battle.teams'))}" hidden>`],
    ['role="group" aria-label="Mode">', `role="group" aria-label="${esc(t('battle.mode'))}">`],
    ['aria-keyshortcuts="M">Mat</button>', `aria-keyshortcuts="M">${esc(t('battle.mat'))}</button>`],
    ['aria-keyshortcuts="M">Arena</button>', `aria-keyshortcuts="M">${esc(t('battle.arena'))}</button>`],
    ['aria-label="Battle speed"', `aria-label="${esc(t('battle.speed'))}"`],
    ['aria-label="Sound" aria-keyshortcuts="N">', `aria-label="${esc(t('battle.sound'))}" aria-keyshortcuts="N">`],
    ['aria-keyshortcuts="R">Replay</button>', `aria-keyshortcuts="R">${esc(t('battle.replay'))}</button>`],
    ['aria-keyshortcuts="L">Log</button>', `aria-keyshortcuts="L">${esc(t('battle.log'))}</button>`],
    ['<a class="key" id="leave" href="/">Leave</a>', `<a class="key" id="leave" href="${l.p('/')}">${esc(t('battle.leave'))}</a>`],
    ['<section class="board" id="board" aria-label="Board">', `<section class="board" id="board" aria-label="${esc(t('battle.board'))}">`],
    ['id="console" aria-label="Commands">', `id="console" aria-label="${esc(t('battle.commands'))}">`],
    ['aria-keyshortcuts="G">Guard</button>', `aria-keyshortcuts="G">${esc(t('battle.guard'))}</button>`],
    ['aria-keyshortcuts="S">Switch</button>', `aria-keyshortcuts="S">${esc(t('battle.switch'))}</button>`],
    ['aria-keyshortcuts="K">Kit</button>', `aria-keyshortcuts="K">${esc(t('battle.kit'))}</button>`],
    ['aria-keyshortcuts="A">Auto</button>', `aria-keyshortcuts="A">${esc(t('battle.auto'))}</button>`],
    ['<span class="sk-key"><kbd>Space</kbd> skips</span>', `<span class="sk-key">${esc(t('battle.skips', { key: '\u0000' })).replace('\u0000', '<kbd>Space</kbd>')}</span>`],
    ['<span class="sk-tap">Tap to skip</span>', `<span class="sk-tap">${esc(t('battle.tapToSkip'))}</span>`],
    ['<dialog id="log" aria-label="Log"><div class="log-head"><b>Log</b><button type="button" class="key" id="log-close">Close</button>', `<dialog id="log" aria-label="${esc(t('battle.log'))}"><div class="log-head"><b>${esc(t('battle.log'))}</b><button type="button" class="key" id="log-close">${esc(t('battle.close'))}</button>`],
  ];
  for (const [from, to] of pairs) {
    const n = body.split(from).length - 1;
    if (n !== 1) throw new Error(`battle page (${code}): expected one ${from.slice(0, 80)}, found ${n}`);
    body = body.replace(from, to);
  }
  return body;
}
// the page's own faces for its language (scripts/i18n-fonts.py), as Base.astro declares them
// each face covers what the battle's own subset lacks (battleRange: é, – and — among them)
const faces = l.en ? [] : Object.values(FACES).filter((f) => f.battleRange && (f.locales.length > 1 || f.locales.includes(l.code)));
// translated words are longer, so the battle's boxes give way rather than spill: a plate's Kit shows its bag and count
// (its name is the key's accessible name), and a phone's strip plate keeps 64 px for the HP and shortens the card's name; the result keeps its summary at least
// 13em wide and lets its keys wrap beside it; the Mat's turn tab uses its short labels up to 1439 px (the rail holds the
// long ones only in English); a plate's trait label gives way before the trait's name (and both before the Kit's count moves; the name's shrink weight is
// 0.001, not 1, so a full label never takes a sub-pixel from the name, which ellipsized it);
// a phone's result keys let a long label take two lines; a
// move's tooltip lets its header and numbers wrap and its column shrink to the tip's
// width (hud.css lays it out at its widest unwrapped row, which at 320 px ran past the 304 px tip); the rail fits at a
// phone's width with the rounds' own narrow-phone spacing (hud.css, 389 px and under), applied below 720 px, and 12 px
// labels under 360 px
const railCss = l.en ? '' : '.pl-kit .pk-left.pk-left>i{display:none}.plate.plate[data-strip="true"]{grid-template-columns:minmax(0,auto) minmax(64px,1fr) auto}.plate.plate[data-strip="true"][data-side="rival"]{grid-template-columns:minmax(0,auto) minmax(64px,1fr) auto auto}.plate.plate[data-strip="true"] .pl-head{min-width:0}.plate.plate[data-strip="true"] .pl-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}@media (min-width:720px){.result.result{grid-template-columns:auto minmax(13em,1fr) minmax(0,auto)}.result.result .result-keys{min-width:0}}@media (min-width:1180px) and (max-width:1439px){.hud[data-mode="mat"] .tt-long,.hud[data-mode="mat"] .tt-first i{display:none}.hud[data-mode="mat"] .tt-short{display:inline}}.pl-trait.pl-trait{display:flex;min-width:0}.pt.pt{min-width:0;overflow:hidden}.pt.pt i{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:0 1000 auto}.pt.pt b{flex:0 .001 auto;min-width:0}@media (max-width:719px){.result-keys.result-keys .key{white-space:normal;line-height:1.15;min-width:0;text-align:center}}.tp-move.tp-move{grid-template-columns:minmax(0,1fr)}.tp-body.tp-body{min-width:0}.tip.tip header{flex-wrap:wrap;row-gap:4px}.tp-nums.tp-nums{flex-wrap:wrap;row-gap:6px}@media (max-width:719px){#app#app .rail-keys{gap:3px}#app#app .rail-keys .tray{padding:3px;gap:3px}#app#app .rail-keys .key{padding:0 7px}#app#app .rail-keys .seg .key{min-width:0}#app#app .speed .key{min-width:38px;padding:0 6px}#app#app .key.snd{min-width:34px;padding:0 6px}}@media (max-width:359px){#app#app .rail-keys .key{padding:0 5px;font-size:12px}#app#app .rail-keys{gap:2px}#app#app .rail-keys .tray{padding:2px;gap:2px}}';
// battle.js points Leave (the rail's and the result's) at the English wall (/#you=...) and titles the tab in English on
// each mode switch, and sound.js names its key Sound; on a translated page Leave goes to this language's wall and the
// title and the key's name stay in the language
const titles = { 'Battle | Kevin Liu': `${t('battle.title')} | ${NAME}`, 'Battle, Arena | Kevin Liu': `${t('battle.titleArena')} | ${NAME}` };
const fixScript = l.en ? '' : String.raw`(function(P,T,S){var d=Object.getOwnPropertyDescriptor(Document.prototype,'title');if(d&&d.set)Object.defineProperty(document,'title',{configurable:true,get:function(){return d.get.call(this)},set:function(v){d.set.call(this,T[v]||v)}});function f(a){if(!a.getAttribute)return;var h=a.getAttribute('href');if(a.tagName==='A'&&h&&/^\/(?:[#?]|$)/.test(h))a.setAttribute('href',P+h.slice(1));if(a.getAttribute('aria-label')==='Sound')a.setAttribute('aria-label',S)}new MutationObserver(function(ms){ms.forEach(function(m){if(m.type==='attributes')f(m.target);else m.addedNodes.forEach(function(n){if(n.nodeType===1){f(n);n.querySelectorAll&&n.querySelectorAll('a[href]').forEach(f)}})})}).observe(document.documentElement,{subtree:true,childList:true,attributes:true,attributeFilter:['href','aria-label']})})(${JSON.stringify(l.p('/'))},${JSON.stringify(titles)},${JSON.stringify(t('battle.sound'))})`;
const faceCss = faces.map((f) => `@font-face{font-family:"Katagami Sans";src:url(${versioned(f.file)}) format("woff2");font-weight:100 900;font-display:block;unicode-range:${f.battleRange}}`).join('');
---
<!doctype html>
<html lang={l.lang} data-boot>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<base href={`/battle/${mode}/`} />
<Seo title={title} description={description} path={path} share={share} imageAlt={alt} jsonld={jsonld} twin={`${path}.md`} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{faces.filter((f) => f.locales.includes(l.code)).map((f) => <link rel="preload" href={versioned(f.file)} as="font" type="font/woff2" crossorigin />)}
{faceCss && <style is:inline set:html={faceCss} />}
{/* the battle's words in this language, read by its modules (deferred, so it runs before them) */}
{!l.en && <script is:inline defer src={battleStringsSrc(l.code)}></script>}
{railCss && <style is:inline set:html={railCss} />}
{fixScript && <script is:inline set:html={fixScript} />}
<script is:inline>/* the page writes its state as a bare "#..." address; under <base> that would move it into its folder, so a hash-only address stays on this page */(function(h){['replaceState','pushState'].forEach(function(k){var f=h[k];h[k]=function(s,t,u){if(typeof u==='string'&&u.charAt(0)==='#')u=location.pathname+location.search+'#'+u.replace(/^#+/,'');return f.call(h,s,t,u)}})})(history)</script>
<script is:inline>/* a boot that never finishes (a script that will not load, an error before the first frame) un-hides the page after 8 s with a reason in the alert, so the alert and Leave can be reached; a boot that finishes first is left alone */(function(d,wait){var asked=false;function check(){asked=false;if(d.dataset.boot===undefined)return;delete d.dataset.boot;var e=document.getElementById('error');if(e&&!e.textContent)e.textContent='The battle could not start. Reload the page, or Leave.'}function later(ev){if(asked||d.dataset.boot===undefined)return;if(ev.type==='error'&&!(ev instanceof ErrorEvent)&&!(ev.target&&ev.target.tagName==='SCRIPT'))return;asked=true;wait(check,8000)}addEventListener('error',later,true);addEventListener('unhandledrejection',later)})(document.documentElement,setTimeout.bind(window))</script>
<Release />
<style is:inline>/* the frosted slips' tile: card.css no longer carries it inline (scripts/sync.mjs), so this page names the file, as ui.css does for the wall. It is the same 1x tile the sheet's fallback printed */:root{--frost:url("/ex/icons/frost.webp")}</style>
<Fragment set:html={battlePage.head} />
<Analytics />
</head>
<body><Fragment set:html={localize(battlePage.body)} /></body>
</html>
