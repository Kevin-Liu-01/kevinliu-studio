---
// The site's one header, on the wall's rails (ui.css header.top). Home names the page with the h1; elsewhere the
// name is the way home and each page's own h1 sits in its content.
import { KL_PATH, M } from '../lib/cards';
interface Props { path: string }
const { path } = Astro.props;
const home = path === '/';
const NAV = [
  { href: '/battle', label: 'Battle' },
  { href: '/about', label: 'About' },
];
---
<header class="top site">
  <a class="brand" href="/" aria-label={home ? undefined : 'Kevin Liu, every card'} data-astro-prefetch={home ? undefined : 'viewport'}>
    <svg class="kl" viewBox="8 5 80 80" aria-hidden="true"><path fill="currentColor" d={KL_PATH} /></svg>
    {home ? <h1>Kevin Liu</h1> : <span class="name">Kevin Liu</span>}
  </a>
  <nav class="links" aria-label="Site">
    {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined} data-astro-prefetch="viewport">{n.label}</a>)}
  </nav>
  <div class="seg" role="group" aria-label="View" style="--i:0">
    {['Human', 'Machine'].map((v, i) => <button type="button" data-mode-set={v.toLowerCase()} aria-pressed={String(!i)} set:html={M.weights(v)} />)}
  </div>
  {home && <button type="button" class="press icon" id="sound" aria-pressed="false" aria-label="Sound"><span class="swapi"><svg class="i off" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 9.5h3.6L11 5.6c.6-.5 1.5-.1 1.5.7v11.4c0 .8-.9 1.2-1.5.7l-4.4-3.9H3a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1Zm13.3.2 1.7 1.7 1.7-1.7a1 1 0 1 1 1.4 1.4L19.4 12.8l1.7 1.7a1 1 0 1 1-1.4 1.4L18 14.2l-1.7 1.7a1 1 0 1 1-1.4-1.4l1.7-1.7-1.7-1.7a1 1 0 1 1 1.4-1.4Z"/></svg><svg class="i on" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 9.5h3.6L11 5.6c.6-.5 1.5-.1 1.5.7v11.4c0 .8-.9 1.2-1.5.7l-4.4-3.9H3a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1Zm12.8-1.9a1 1 0 0 1 1.4.1 6.6 6.6 0 0 1 0 8.6 1 1 0 1 1-1.5-1.3 4.6 4.6 0 0 0 0-6 1 1 0 0 1 .1-1.4Zm3-2.6a1 1 0 0 1 1.4 0 10.4 10.4 0 0 1 0 14 1 1 0 1 1-1.4-1.4 8.4 8.4 0 0 0 0-11.2 1 1 0 0 1 0-1.4Z"/></svg></span></button>}
  {home && <button type="button" class="press icon" id="pause" aria-pressed="false" aria-label="Pause Motion"><span class="swapi" set:html={`${M.icon('pause', 'off')}${M.icon('play', 'on')}`} /></button>}
  {/* the wall's sound and pause keys keep their room on every other page, so the links and the view switch never move between pages */}
  {!home && <span class="press icon spacer" aria-hidden="true"></span><span class="press icon spacer" aria-hidden="true"></span>}
  <script is:inline>/* the view switch, sound and pause keys start in the state the page's scripts give them after load (Base.astro's mode script, sound.js preference, gallery.js setPaused), so no key flips on screen */(function(d){var m=d.dataset.mode==='machine';document.querySelectorAll('header.top [data-mode-set]').forEach(function(b){b.setAttribute('aria-pressed',String((b.dataset.modeSet==='machine')===m))});document.querySelector('header.top .seg').style.setProperty('--i',m?1:0);var s=document.getElementById('sound'),p=document.getElementById('pause');if(s){var on=false;try{var k=localStorage.getItem('kevin-liu-studio:sound');on=k==='on'||k===null&&!matchMedia('(prefers-reduced-motion: reduce)').matches}catch(e){}s.setAttribute('aria-pressed',String(on));d.dataset.sound=on?'on':'off'}if(p)p.setAttribute('aria-pressed',String('paused' in d.dataset))})(document.documentElement)</script>
</header>
