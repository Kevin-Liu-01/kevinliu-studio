---
// The footer: where else Kevin is. In the Machine view the same box holds those links as addresses, the files an agent
// starts from, and behind one line (its status, type and size) the commands that fetch this page and its whole twin.
import { SOCIAL, EMAIL, SITE } from '../lib/site';
import { TWINS } from '../lib/twins';
interface Props { path: string; twin?: string | null }
const { path, twin: twinLink } = Astro.props;
const twin = TWINS[path] ? (path === '/' ? '/index.md' : `${path}.md`) : null;
const md = twin ? TWINS[path]() : '';
const cmds = [
  `curl -s ${SITE}/llms.txt`,
  `curl -s ${SITE}/llms-full.txt`,
  ...(twin ? [`curl -s -H "Accept: text/markdown" ${SITE}${path}`] : []),
];
const bare = (u: string) => u.replace(/^https?:\/\//, '');
---
<footer class="foot">
  <nav aria-label="Elsewhere">
    {SOCIAL.map((s) => <a href={s.url} rel="me">{s.name}</a>)}
    <a href={`mailto:${EMAIL}`}>Email</a>
    <a href="/cards">Cards</a>
    {twinLink && <a href={twinLink} type="text/markdown">Markdown</a>}
    <a href="/llms.txt">llms.txt</a>
    <button type="button" class="tomachine" data-mode-set="machine" aria-pressed="false">Machine</button>
  </nav>
  <div class="mx fm">
    <nav aria-label="Elsewhere">
      {SOCIAL.map((s) => <a href={s.url} rel="me">{bare(s.url)}</a>)}
      <a href={`mailto:${EMAIL}`}>mailto:{EMAIL}</a>
      <a href="/cards">/cards</a>
      {twinLink && <a href={twinLink} type="text/markdown">{twinLink}</a>}
      <a href="/llms.txt">/llms.txt</a>
      <a href="/llms-full.txt">/llms-full.txt</a>
      <a href="/sitemap-index.xml">/sitemap-index.xml</a>
      <button type="button" class="tohuman" data-mode-set="human" aria-pressed="false">Human</button>
      <details>
        <summary>{twin ? `HTTP 200 · text/markdown · ${Buffer.byteLength(md).toLocaleString('en-US')} bytes` : 'HTTP 404 · no twin'}</summary>
        <pre class="cmds">{cmds.map((c) => `$ ${c}`).join('\n')}</pre>
        {twin && <pre class="twin">{md}</pre>}
      </details>
    </nav>
  </div>
</footer>
