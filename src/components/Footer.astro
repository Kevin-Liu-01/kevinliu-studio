---
// The footer: where else Kevin is. In the Machine view the same box holds those links as addresses, the files an agent
// starts from, and behind one line (its status, type and size) the commands that fetch this page and its whole twin.
import { SOCIAL, EMAIL, SITE } from '../lib/site';
import { TWINS, twinPath } from '../lib/twins';
import { of } from '../i18n';
interface Props { path: string; twin?: string | null }
const { path, twin: twinLink } = Astro.props;
const l = of(path);
const twin = TWINS[path] ? twinPath(path) : null;
const md = twin ? TWINS[path]() : '';
const cmds = [
  `curl -s ${SITE}${l.p('/llms.txt')}`,
  `curl -s ${SITE}${l.p('/llms-full.txt')}`,
  ...(twin ? [`curl -s -H "Accept: text/markdown" ${SITE}${path}`] : []),
];
const bare = (u: string) => u.replace(/^https?:\/\//, '');
---
<footer class="foot">
  <nav aria-label={l.t('frame.elsewhere')}>
    {SOCIAL.map((s) => <a href={s.url} rel="me">{s.name}</a>)}
    <a href={`mailto:${EMAIL}`}>{l.t('frame.email')}</a>
    <a href={l.p('/cards')}>{l.t('frame.cards')}</a>
    {twinLink && <a href={twinLink} type="text/markdown">{l.t('frame.markdown')}</a>}
    <a href={l.p('/llms.txt')}>llms.txt</a>
    <button type="button" class="tomachine" data-mode-set="machine" aria-pressed="false">{l.t('frame.machine')}</button>
  </nav>
  <div class="mx fm">
    <nav aria-label={l.t('frame.elsewhere')}>
      {SOCIAL.map((s) => <a href={s.url} rel="me">{bare(s.url)}</a>)}
      <a href={`mailto:${EMAIL}`}>mailto:{EMAIL}</a>
      <a href={l.p('/cards')}>{l.p('/cards')}</a>
      {twinLink && <a href={twinLink} type="text/markdown">{twinLink}</a>}
      <a href={l.p('/llms.txt')}>{l.p('/llms.txt')}</a>
      <a href={l.p('/llms-full.txt')}>{l.p('/llms-full.txt')}</a>
      <a href="/sitemap-index.xml">/sitemap-index.xml</a>
      <button type="button" class="tohuman" data-mode-set="human" aria-pressed="false">{l.t('frame.human')}</button>
      <details>
        <summary>{twin ? `200 · text/markdown · ${Buffer.byteLength(md).toLocaleString('en-US')} B` : `404 · ${l.t('frame.noTwin')}`}</summary>
        <pre class="cmds">{cmds.map((c) => `$ ${c}`).join('\n')}</pre>
        {twin && <pre class="twin">{md}</pre>}
      </details>
    </nav>
  </div>
</footer>
