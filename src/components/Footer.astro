---
import { SOCIAL, EMAIL } from '../lib/site';
interface Props { twin?: string | null }
const { twin } = Astro.props;
---
<footer class="foot">
  <nav aria-label="Elsewhere">
    {SOCIAL.map((s) => <a href={s.url} rel="me">{s.name}</a>)}
    <a href={`mailto:${EMAIL}`}>Email</a>
    <a href="/cards">Cards</a>
    {twin && <a href={twin} type="text/markdown">Markdown</a>}
    <a href="/llms.txt">llms.txt</a>
    <a href="/sitemap-index.xml">Sitemap</a>
    <button type="button" class="tomachine" data-mode-set="machine" aria-pressed="false">Machine</button>
  </nav>
</footer>
