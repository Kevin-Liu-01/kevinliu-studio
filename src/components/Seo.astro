---
// Every page's head metadata: title, description, canonical, share cards (image, and the loop where the rounds drew
// one), the Markdown twin and JSON-LD. One component, so no page can ship without a canonical or a share image.
import { NAME, HANDLE, SITE, abs } from '../lib/site';
import { LOCALES, localeOf, lp, split } from '../i18n/locales.mjs';
import { twinOf } from '../lib/twins';

interface Props {
  title: string;
  fullTitle?: string; // the whole <title>, where "title | Kevin Liu" would repeat the name
  description: string;
  path: string;
  og?: string; // a round's share pair: og/<name>.jpg (1200x630) and og/<name>.mp4 (2400x1260)
  share?: string; // a share image built at build time instead: share/<name>.jpg (1200x630, src/lib/share.ts)
  imageAlt: string;
  type?: 'website' | 'profile' | 'article';
  jsonld?: object[]; // nodes of one @graph
  twin?: string | null; // the Markdown twin's path
  noindex?: boolean; // the 404 page: no canonical, kept out of the index
}
const { title, description, path, share, og = share ? undefined : 'home', imageAlt, type = 'website', jsonld = [], noindex = false, twin = twinOf(path) } = Astro.props;
// the page's language from its path, and the same page in every language (hreflang, og:locale:alternate)
const { code, path: base } = split(path);
const here = localeOf(code);
const fullTitle = Astro.props.fullTitle ?? (base === '/' ? title : `${title} | ${NAME}`);
// a translated description keeps to the 160 characters a result shows: its first sentences that fit, else cut at a word
// (at a character in a language without spaces) with an ellipsis. English descriptions are written to fit.
const fit = (s: string) => {
  if (code === 'en' || s.length <= 160) return s;
  const sentences = s.match(/[^.!?。！？]+[.!?。！？]+/g) ?? [];
  let out = '';
  for (const x of sentences) { if ((out + x).trim().length > 160) break; out += x; }
  if (out.trim().length >= 50) return out.trim();
  // else the sentence up to its last colon or semicolon that fits ("Kevin Liu's projects as 26 collectible cards.")
  const clause = s.slice(0, 159).match(/^(.*)[:;：；]/)?.[1]?.trim();
  if (clause && clause.length >= 50) return `${clause}${/[\u3000-\u9fff\uac00-\ud7af]$/.test(clause) ? '。' : '.'}`;
  const cut = s.slice(0, 159);
  return `${/\s/.test(cut) ? cut.replace(/[\s,:;]+\S*$/, '') : cut}…`;
};
const url = abs(path);
const image = share ? `${SITE}/share/${share}.jpg` : `${SITE}/og/${og}.jpg`;
const video = og ? `${SITE}/og/${og}.mp4` : null;

const ld = jsonld.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonld }).replace(/</g, '\\u003c') : null;
---
<title>{fullTitle}</title>
<meta name="description" content={fit(description)} />
{!noindex && <link rel="canonical" href={url} />}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="author" content={NAME} />
{twin && <link rel="alternate" type="text/markdown" href={twin} title="Markdown" />}
<link rel="alternate" type="text/plain" href={lp(code, '/llms.txt')} title="llms.txt" />
{!noindex && LOCALES.map((l) => <link rel="alternate" hreflang={l.lang} href={abs(lp(l.code, base))} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={abs(base)} />}
<link rel="author" href={lp(code, '/about')} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={NAME} />
<meta property="og:locale" content={here.og} />
{!noindex && LOCALES.filter((l) => l !== here).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={fit(description)} />
{!noindex && <meta property="og:url" content={url} />}
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{type === 'profile' && <meta property="profile:first_name" content="Kevin" />}
{type === 'profile' && <meta property="profile:last_name" content="Liu" />}
{type === 'profile' && <meta property="profile:username" content={HANDLE.slice(1)} />}
{video && <meta property="og:video" content={video} />}
{video && <meta property="og:video:type" content="video/mp4" />}
{video && <meta property="og:video:width" content="2400" />}
{video && <meta property="og:video:height" content="1260" />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={HANDLE} />
<meta name="twitter:creator" content={HANDLE} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={fit(description)} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
{ld && <script type="application/ld+json" set:html={ld} />}
