---
import Base from '../layouts/Base.astro';
import { fighters, whatOf } from '../lib/cards';
import { cardPath, QA } from '../lib/twins';
import { website, page } from '../lib/schema';
import { SITE, NAME, BIO, ABOUT, SOCIAL, EMAIL, person } from '../lib/site';
const social = (n: string) => SOCIAL.find((s) => s.name === n)!;
// Kevin's employer is named only here and in the files that print this page (docs/content.md)
const kevin = { ...person, worksFor: { '@type': 'Organization', name: 'General Translation', url: 'https://generaltranslation.com' } };
const jsonld = [website, kevin, ...page({ path: '/about', type: 'ProfilePage', name: `About ${NAME}`, description: BIO, image: `${SITE}/share/about.jpg`, crumbs: [['About', '/about']], mainEntity: { '@id': person['@id'] } })];
---
<Base seo={{ title: 'About', fullTitle: `About ${NAME}`, description: BIO, path: '/about', type: 'profile', share: 'about', imageAlt: `${NAME}, with the Claude of Tanks, Katagami and Turboslide cards`, jsonld }}>
  <main class="prose" id="main">
    <h1>About {NAME}</h1>
    {ABOUT.map((runs, i) => (
      <p class={i === 0 ? 'lede' : undefined}>{runs.map((r) => (typeof r === 'string' ? r : <a href={r[1]}>{r[0]}</a>))}</p>
    ))}
    <p>Find me on {['X', 'GitHub', 'LinkedIn'].map((n, i) => <>{i ? (i === 2 ? ', and ' : ', ') : ''}<a href={social(n).url} rel="me">{n}</a></>)}, or write to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
    <h2>Projects</h2>
    <ul>
      {fighters.map((f) => <li><a href={cardPath(f)}>{f.title}</a>. {whatOf(f)}</li>)}
    </ul>
    <h2>Questions</h2>
    <dl>
      {QA.map(([q, a]) => <Fragment><dt>{q}</dt><dd>{a}</dd></Fragment>)}
    </dl>
  </main>
</Base>
