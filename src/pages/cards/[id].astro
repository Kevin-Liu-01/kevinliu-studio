---
import Base from '../../layouts/Base.astro';
import { fighters, card, M, answerOf, factLines, hueOf, repoOf, relatedOf, teamFor, type Fighter } from '../../lib/cards';
import { cardPath } from '../../lib/twins';
import { graph, page, work } from '../../lib/schema';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return fighters.map((f) => ({ params: { id: f.id }, props: { f } }));
}
const { f } = Astro.props as { f: Fighter };
const i = fighters.indexOf(f);
const prev = fighters[(i + fighters.length - 1) % fighters.length];
const next = fighters[(i + 1) % fighters.length];
const answer = answerOf(f);
const hue = hueOf(f);
const repo = repoOf(f);
const related = relatedOf(f);
const team = teamFor(f.id);
const pinned = (f as any).pinned as { sha: string; date?: string } | undefined;
// a description is one sentence of at most 160 characters, cut at a word
const description = answer.length <= 160 ? answer : `${answer.slice(0, 159).replace(/[\s,:;]+\S*$/, '')}.`;
const jsonld = graph(
  page({ path: cardPath(f), type: 'ItemPage', name: f.title, description: answer, image: `${SITE}/og/${f.id}.jpg`, crumbs: [['Cards', '/cards'], [f.title, cardPath(f)]], mainEntity: { '@id': `${SITE}${cardPath(f)}#work` } }),
  work(f),
);
const discIcon = (d: string) => M.icon(d.toLowerCase());
---
<Base
  seo={{ title: f.title, description, path: cardPath(f), og: f.id, imageAlt: `The ${f.title} card: ${answer}`, jsonld }}
  room
  html={{ 'data-card': f.id }}
>
  <main class="cardpage" id="main" style={`--hue-e:${hue.energy ?? '#c9c2b8'};--hue-d:${hue.deep ?? '#3a332c'}`}>
    <div class="stand" set:html={card(f, { id: `c-${f.id}`, focusable: false })} />
    <article class="info">
      <h1>{f.title}</h1>
      <p class="cp-what">{answer}</p>
      <p class="cp-disc">{f.disciplines.map((d) => <span><Fragment set:html={discIcon(d)} />{d}</span>)}</p>
      <p class="cp-go">
        {f.url && <a class="press" href={f.url} rel="noopener"><Fragment set:html={M.icon('visit')} /><span>Open {f.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span></a>}
        {repo && <a class="press" href={repo} rel="noopener"><span>Source</span></a>}
        {team && <a class="press" href={`/battle#team=${team.join(',')}`}><span>Battle</span></a>}
      </p>
      <h2>The numbers</h2>
      <ul class="cp-facts">
        {factLines(f).map((x) => <li><b>{x.value}</b><span>{x.unit}</span><code>{x.receipt}</code></li>)}
      </ul>
      {f.trait && <Fragment><h2>Trait</h2><div class="cp-trait"><p><b>{f.trait.name}</b> {f.trait.rule}</p><code>{f.trait.receipt}</code></div></Fragment>}
      <h2>Moves</h2>
      <ol class="cp-moves">
        {f.moves.map((mv) => <li><p set:html={M.moveText(mv)} /><code>{mv.receipt}</code></li>)}
      </ol>
      <h2>Related</h2>
      <ul class="cp-related">
        {related.map((g) => <li><a href={cardPath(g)}><b>{g.title}</b><span>{g.disciplines.join(', ')}</span></a></li>)}
      </ul>
      {pinned && <p class="cp-pin">Numbers pinned at {repo ? <a href={`${repo}/commit/${pinned.sha}`} rel="noopener">{pinned.sha}</a> : pinned.sha}{pinned.date ? `, ${pinned.date}` : ''}.</p>}
    </article>
  </main>
  <nav class="pager" aria-label="Cards">
    <a href={cardPath(prev)} rel="prev" data-astro-prefetch="viewport"><Fragment set:html={M.icon('prev')} />{prev.title}</a>
    <a href={cardPath(next)} rel="next" data-astro-prefetch="viewport">{next.title}<Fragment set:html={M.icon('next')} /></a>
  </nav>
</Base>
