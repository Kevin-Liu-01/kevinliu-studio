---
import Base from '../layouts/Base.astro';
import { fighters, rules, card, M, env, battleRoster, whatOf, roundScripts } from '../lib/cards';
import { cardPath } from '../lib/twins';
import { cardRecord, recordHtml, deckRecord, packRecord } from '../lib/machine';
import { versioned } from '../lib/assets';
import { graph, page, cardList } from '../lib/schema';
import { SITE, NAME, DESCRIPTION } from '../lib/site';

const ART_RATIO = 88 / 63;
// The wall's first screen (two rows of up to seven, the widest the gallery sets) loads with the page and its first
// poster first; the cards below wait until the page has loaded, then fetch at idle (the script under the wall), so the
// first screen never shares the line with pictures nobody can see yet, and no lens, pack or dock ever opens on a hole.
// On a touch screen the rest stay lazy: a phone decodes only the cards it has scrolled to (docs/performance.md, Memory).
const FIRST_SCREEN = 14;
const lazy = (html: string) => html.replace(/<img /g, '<img loading="lazy" ');
const wall = fighters.map((f, i) => {
  const c = card(f);
  const html = i === 0 ? c.replace('<img class="poster" ', '<img class="poster" fetchpriority="high" ') : i < FIRST_SCREEN ? c : lazy(c);
  // the card is the lens's button; its page is a plain link beside it, for crawlers, agents and pages without scripts
  return `<li class="pocket" style="--n:${i}">${html}<a class="sr" href="${cardPath(f)}" tabindex="-1" aria-hidden="true">${f.title}</a>${recordHtml(f.title, cardRecord(f))}</li>`;
}).join('\n');
// The Machine view's forms of the deck, the pack and the dock, nested in the real controls: where the deck goes, what
// the pack fills, and the team, rival and seed the dock holds (filled from gallery.js's __table by the script below)
const deck = M.deck().replace(/<\/a>\s*$/, `${recordHtml('Previous site', deckRecord(), { links: false })}</a>`);
const pack = M.pack(fighters, ART_RATIO, env).replace(/<\/button>\s*$/, `${recordHtml('Open Pack', packRecord(), { links: false })}</button>`);
const dock = (M.dock([], [], fighters, rules, env) as string)
  .replace(/<span class="hold"><\/span>/g, '$&<span class="mx" data-live="slot"></span>')
  .replace(/(<button type="button" class="play"[^>]*>)/, '$1<span class="mx" aria-hidden="true"><span>/battle</span><span data-live="seed"></span></span>');
const roster = battleRoster ? `${Object.entries(battleRoster.cost).map(([id, c]) => `${id}:${c}`).join(' ')} budget:${battleRoster.budget}` : null;
const jsonld = graph(page({ path: '/', type: 'CollectionPage', name: NAME, description: DESCRIPTION, image: `${SITE}/og/home.jpg`, mainEntity: { '@id': cardList['@id'] } }), cardList);
---
<Base
  seo={{ title: NAME, description: DESCRIPTION, path: '/', og: 'home', imageAlt: `${NAME}'s ${fighters.length} project cards`, jsonld }}
  room
  heavy
  main="gallery"
  scripts={roundScripts.filter((s) => s !== 'gallery.js')}
>
  <Fragment slot="head">
    <script is:inline>document.documentElement.dataset.hold = ''</script>
    <meta name="battle" content="/battle" />
    {roster && <meta name="battle-roster" content={roster} />}
    <script is:inline type="module" src={versioned('/sound/boot.gallery.js')}></script>
    <script is:inline defer src={versioned('/ex/gallery.js')}></script>
  </Fragment>
  <main class="gallery" id="gallery">
    <ul class="wall" aria-label="Cards" set:html={`${wall}\n<li class="pocket tile">${deck}</li>\n<li class="pocket tile">${pack}</li>`} />
    <script is:inline>/* the page shows once the pictures of the cards on screen are decoded (1 s at most), so it paints whole instead of card by card; in the Machine view no picture shows, so it waits on none and fetches none ahead; the cards below load unseen, and the rest fetch at idle once the page has loaded (on a touch screen they stay lazy and load as they near the screen, so a phone holds only the pictures it has shown). At that idle one silent context is made and closed: the browser's first AudioContext waits on its audio service starting (seconds on a busy phone), and the sound kit makes its own in the visitor's first press, so that press no longer pays for it. Nothing plays and nothing is fetched (docs/sound.md). On a touch screen or a small-memory device the cards' lit frames give way to their unlit borders first (scripts/phone-memory.mjs) */(function(d){if(matchMedia("(pointer: coarse)").matches||navigator.deviceMemory<=4)document.querySelectorAll("img[data-unlit]").forEach(function(i){i.src=i.dataset.unlit});var vh=innerHeight,imgs=[],mx=d.dataset.mode==="machine";if(!mx)document.querySelectorAll(".wall > .pocket").forEach(function(p){var r=p.getBoundingClientRect();if(r.top<vh&&r.bottom>0)p.querySelectorAll("img").forEach(function(i){imgs.push(i.decode().catch(function(){}))})});Promise.race([Promise.all(imgs),new Promise(function(r){setTimeout(r,1000)})]).then(function(){delete d.dataset.hold});addEventListener("load",function(){(self.requestIdleCallback||setTimeout)(function(){if(!mx&&!matchMedia("(pointer: coarse)").matches)document.querySelectorAll('img[loading="lazy"]').forEach(function(i){i.loading="eager"});try{var k=localStorage.getItem("kevin-liu-studio:sound"),C=self.AudioContext||self.webkitAudioContext;if(C&&(k==="on"||k===null&&!matchMedia("(prefers-reduced-motion: reduce)").matches))new C().close()}catch(e){}})},{once:true})})(document.documentElement)</script>
    <script is:inline>/* a card more than a screen away drops its filters (the cracks' glow, the symbols' shadows, a cost 4 card's colour): WebKit keeps a device-size buffer for every filtered box it has painted, about 190 MB for the 26 cards on an iPhone. It takes them back a screen before it shows (site.css, docs/performance.md) */if("IntersectionObserver"in self){var far=new IntersectionObserver(function(es){es.forEach(function(e){e.target.toggleAttribute("data-far",!e.isIntersecting)})},{rootMargin:"100% 0px"});document.querySelectorAll(".wall > .pocket").forEach(function(p){far.observe(p)})}</script>
  </main>
  <Fragment set:html={dock} />
  <script is:inline>/* the Machine view's live parts: each well names the card it holds and the pack and Play the seed, as gallery.js's __table has them (the state the battle address carries, #team=a,b,c&rival=x,y,z&seed=N). They follow the dock's own changes */(function(){var d=document.querySelector('.dock');if(!d)return;function fill(){var t=self.__table;if(!t)return;var ws=d.querySelectorAll('.well');ws.forEach(function(w){var m=w.querySelector('[data-live="slot"]'),side=w.closest('.rival')?t.rival:t.you;if(m)m.textContent=side[+w.dataset.slot]||''});document.querySelectorAll('[data-live="seed"]').forEach(function(s){s.textContent=(s.closest('.play')?'seed=':'')+t.seed})}addEventListener('load',fill);if('MutationObserver'in self)new MutationObserver(fill).observe(d,{subtree:true,attributes:true,attributeFilter:['aria-label','data-state']})})()</script>
  <Fragment slot="overlay">
    <canvas id="world" aria-hidden="true"></canvas>
    <div class="stage" id="stage" aria-hidden="true"></div>
    <Fragment set:html={M.inspect()} />
    <p class="sr" role="status" id="status"></p>
  </Fragment>
</Base>
