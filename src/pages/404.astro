---
import Base from '../layouts/Base.astro';
import { graph } from '../lib/schema';
---
<Base seo={{ title: 'Not found', description: 'This page does not exist. Every one of Kevin Liu\'s project cards is on the cards index.', path: '/404', share: '404', imageAlt: 'Not found', twin: null, noindex: true, jsonld: graph() }}>
  <main class="prose" id="main">
    <div class="sw hw"><h1>Not found</h1><p class="mx"># Not found</p></div>
    <p class="sw"><span class="hx">This address holds no card. <a href="/cards">Every card</a> is on the index.</span><span class="mx">HTTP 404. <a href="/cards">/cards</a> lists every card.</span></p>
  </main>
</Base>
