---
import Base from '../layouts/Base.astro';
---
<Base seo={{ title: 'Not found', description: 'This page does not exist. Every card is on the home page.', path: '/404', twin: null, noindex: true }}>
  <main class="prose" id="main">
    <h1>Not found</h1>
    <p class="sw"><span class="hx">This address holds no card. <a href="/">Every card is on the home page.</a></span><span class="mx">HTTP 404. <a href="/index.md">/index.md</a> lists every card.</span></p>
  </main>
</Base>
