---
import Base from '../layouts/Base.astro';
import { logoOf, cardIds, byCard } from '../lib/cards';
import Link from '../components/BrandLink.astro';
import { inlineLogo, markPair } from '../lib/brands';
import { cardPath, qaOf, aboutParts, aboutProjects, whatIn, bioIn } from '../lib/twins';
import { L, localeOf } from '../i18n';
import { mdHtml } from '../lib/machine';
import { website, page } from '../lib/schema';
import { SITE, NAME, ABOUT, ABOUT_NO_LOGO, ABOUT_INK_FIGURE, ABOUT_LOGO_PAIR, SOCIAL, EMAIL, person } from '../lib/site';
interface Props { code: string }
const { code } = Astro.props;
const l = L(code);
const BIO = bioIn(code);
const QA = qaOf(code);
// a paragraph of Kevin's words as runs of text and links, from its Markdown in the language
const runsOf = (i: number) => (aboutParts(code).paras[i].split(/(\[[^\]]+\]\([^)]+\))/).filter(Boolean).map((x) => { const m = /^\[([^\]]+)\]\(([^)]+)\)$/.exec(x); return m ? ([m[1], m[2]] as const) : x; }));
// "Find me on X, GitHub, and LinkedIn, or write to the email": the sentence in the language, its four links in place
// a project's name and what it is: "Turboslide. A browser..."; Japanese and Chinese take a full-width colon, Korean a colon
const sep = localeOf(code).gloss;
const findMe = l.t('about.elsewhere').split(/(\{x\}|\{github\}|\{linkedin\}|\{email\})/);
const social = (n: string) => SOCIAL.find((s) => s.name === n)!;
// the Machine view's forms: the twin's blocks where the page shows them (its headings are the page's own, marked by
// machine.css). The twin's line about the cards has no place of its own on the page; it is in the footer's whole twin
const tw = aboutParts(code);
const paras = tw.paras;
const H = { projects: `## ${l.t('about.projects')}`, questions: `## ${l.t('about.questions')}`, elsewhere: `## ${l.t('frame.elsewhere')}` };
const projects = tw.projects;
const questions = tw.questions;
// the sentence that names X, GitHub and LinkedIn and the email holds the twin's lines for those four
const elsewhere = [...SOCIAL.filter((s) => ['X', 'GitHub', 'LinkedIn'].includes(s.name)).map((s) => tw.social[s.name]), tw.email].join('\n');
// each project's logo as its card prints it (the file and its tile, no ring), hung left of the underlined name;
// a project without one keeps the empty column, so every name starts at the same x
// the logo and the name's first word never part at a line end (BrandLink.astro does the same)
const first = (t: string) => t.split(' ')[0], rest = (t: string) => t.slice(first(t).length);
const noLogo = cardIds(ABOUT_NO_LOGO, 'site.ts ABOUT_NO_LOGO');
const inkFigure = cardIds(ABOUT_INK_FIGURE, 'site.ts ABOUT_INK_FIGURE');
const logos = Object.fromEntries(aboutProjects.map((f) => [f.id, noLogo.includes(f.id) ? null : logoOf(f)]));
const pairs = Object.fromEntries(Object.entries(byCard(ABOUT_LOGO_PAIR, 'site.ts ABOUT_LOGO_PAIR')).map(([id, files]) => [id, markPair(files)]));
// X prints as 𝕏 in the system's symbol face (no Katagami face holds it), named "X" for screen readers
const heading = l.t('about.heading', { name: NAME });
const jsonld = [website, person, ...page({ path: l.p('/about'), type: 'ProfilePage', name: heading, description: BIO, image: `${SITE}/share/about.jpg`, crumbs: [[l.t('about.title'), l.p('/about')]], mainEntity: { '@id': person['@id'] }, code })];
---
<Base seo={{ title: l.t('about.title'), fullTitle: heading, description: BIO, path: l.p('/about'), type: 'profile', share: 'about', imageAlt: l.t('about.imageAlt', { name: NAME }), jsonld }}>
  <main class="prose" id="main">
    <div class="sw hw"><h1>{heading}</h1><p class="mx" aria-hidden="true" set:html={mdHtml(`# ${tw.heading}`)} /></div>
    {ABOUT.map((_, i) => (
      <p class:list={[i === 0 && 'lede', 'sw']}><span class="hx">{runsOf(i).map((r) => (typeof r === 'string' ? r : <Link href={r[1]} text={r[0]} />))}</span><span class="mx" set:html={mdHtml(paras[i])} /></p>
    ))}
    {l.en
      ? <p class="sw"><span class="hx">Find me on {['X', 'GitHub', 'LinkedIn'].map((n, i) => <>{i ? (i === 2 ? ', and ' : ', ') : ''}{n === 'X' ? <a href={social(n).url} rel="me" aria-label="X"><span class="sym">𝕏</span></a> : <Link href={social(n).url} text={n} me />}</>)}, or write to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</span><span class="mx" set:html={mdHtml(elsewhere)} /></p>
      : <p class="sw"><span class="hx">{findMe.map((x) => x === '{email}' ? <a href={`mailto:${EMAIL}`}>{EMAIL}</a> : x === '{x}' ? <a href={social('X').url} rel="me" aria-label="X"><span class="sym">𝕏</span></a> : x === '{github}' ? <Link href={social('GitHub').url} text="GitHub" me /> : x === '{linkedin}' ? <Link href={social('LinkedIn').url} text="LinkedIn" me /> : x)}</span><span class="mx" set:html={mdHtml(elsewhere)} /></p>}
    <div class="sw hw"><h2>{l.t('about.projects')}</h2><p class="mx" aria-hidden="true" set:html={mdHtml(H.projects)} /></div>
    <ul class="projects">
      {aboutProjects.map((f, i) => { const g = logos[f.id]; return <li class="sw"><span class="hx"><a class="pl" href={cardPath(f, code)}>{pairs[f.id] ? <><span class="nw"><span class="plogo wide" set:html={pairs[f.id]} /><span class="pt">{first(f.title)}</span></span>{rest(f.title) && <span class="pt">{rest(f.title)}</span>}</> : g ? <><span class="nw"><span class:list={['plogo', g.ground && 'on', g.fill && 'fill', g.ink && 'ink']} style={g.ground ? `--lg:${g.ground}` : undefined}>{inkFigure.includes(f.id) ? <Fragment set:html={inlineLogo(g.src)} /> : <img src={g.src} alt="" width="16" height="16" draggable="false" />}</span><span class="pt">{first(f.title)}</span></span>{rest(f.title) && <span class="pt">{rest(f.title)}</span>}</> : <span class="pt">{f.title}</span>}</a>{sep}{whatIn(f, code)}</span><span class="mx" set:html={mdHtml(projects[i])} /></li>; })}
    </ul>
    <div class="sw hw"><h2>{l.t('about.questions')}</h2><p class="mx" aria-hidden="true" set:html={mdHtml(H.questions)} /></div>
    <dl>
      {/* each question and answer is one paragraph of the twin, "**question** answer", split across its dt and dd */}
      {QA.map(([q, a], i) => <Fragment><dt class="sw"><span class="hx">{q}</span><span class="mx" set:html={mdHtml(questions[i].slice(0, questions[i].indexOf('** ') + 2))} /></dt><dd class="sw"><span class="hx">{a}</span><span class="mx" set:html={mdHtml(questions[i].slice(questions[i].indexOf('** ') + 3))} /></dd></Fragment>)}
    </dl>
  </main>
</Base>
