---
import Base from '../layouts/Base.astro';
import { fighters, rules, card, M, env, battleRoster, whatOf, hueOf, roundScripts, FRAMED } from '../lib/cards';
import { cardPath, descriptionIn } from '../lib/twins';
import { roomIn, galleryShim, shimHash } from '../lib/i18n-room';
import { L } from '../i18n';
import { cardRecord, cardLabel, recordHtml, deckRecord, packRecord, BX } from '../lib/machine';
import { asciiArt } from '../lib/ascii';
import { versioned } from '../lib/assets';
import { graph, page, cardListIn } from '../lib/schema';
import { SITE, NAME, HOME_TITLE, HOME_DESCRIPTION } from '../lib/site';

interface Props { code: string }
const { code } = Astro.props;
const l = L(code);
const cardList = cardListIn(code);
const DESCRIPTION = descriptionIn(code);

const ART_RATIO = 88 / 63;
// The wall's first screen on a desktop (two rows of up to seven, the widest the gallery sets) loads with the page
// and its first poster first; the cards below wait until the page has loaded, then fetch at idle (the script under
// the wall), so the first screen never shares the line with pictures nobody can see yet, and no lens, pack or dock
// ever opens on a hole. A touch screen's first screen is one column, about a card and a half: only the first
// TOUCH_FIRST cards load with the page there, and the rest stay lazy, so a phone fetches and decodes only the cards
// it has scrolled to (docs/performance.md, Memory). Cards TOUCH_FIRST + 1 to FIRST_SCREEN print lazy and the script
// right under the wall (EAGER) makes them eager again on a fine pointer while the page is still parsing.
const FIRST_SCREEN = 14;
const TOUCH_FIRST = 2;
const EAGER = `if(!matchMedia("(pointer: coarse)").matches)document.querySelectorAll('.wall > .pocket:nth-child(-n+${FIRST_SCREEN}) img[loading="lazy"]').forEach(function(i){i.loading="eager"})`;
const lazy = (html: string) => html.replace(/<img (?!loading=)/g, '<img loading="lazy" ');
// the Machine view's art: each card's subject as text, 40 characters wide (lib/ascii.ts)
const arts = await Promise.all(fighters.map((f) => asciiArt(f.id, 40)));
const wall = fighters.map((f, i) => {
  const c = card(f);
  const html = i === 0 ? c.replaceAll('<img class="poster" ', '<img class="poster" fetchpriority="high" ') : i < TOUCH_FIRST ? c : lazy(c);
  // the card is the lens's button once gallery.js has booted; until then (no scripts, or a round script that failed to
  // load) its page is a plain link beside it, which the script under the wall takes out of the tab order afterwards
  return `<li class="pocket" data-far style="--n:${i}">${roomIn(html, code)}<a class="sr golink" href="${cardPath(f, code)}">${f.title}</a>${recordHtml(f.title, cardRecord(f, { code }), { label: cardLabel(f), art: arts[i], color: hueOf(f).energy })}</li>`;
}).join('\n');
// The Machine view's forms of the deck, the pack and the dock, nested in the real controls: where the deck goes, what
// the pack fills, and the team, rival and seed the dock holds (filled from gallery.js's __table by the script below)
const deck = roomIn(M.deck(), code).replace(/<\/a>\s*$/, `${recordHtml(l.t('home.previousSite'), deckRecord(), { links: false })}</a>`);
const pack = roomIn(M.pack(fighters, ART_RATIO, env), code).replace(/<\/button>\s*$/, `${recordHtml(l.t('home.openPack'), packRecord(code), { links: false })}</button>`);
const dock = roomIn(M.dock([], [], fighters, rules, env) as string, code)
  .replace(/<span class="hold"><\/span>/g, `$&${BX}<span class="mx" data-live="slot"></span>`)
  .replace(/(<nav class="dock"[^>]*>)/, `$1${BX}`)
  .replace(/(<button type="button" class="play"[^>]*>)/, `$1<span class="mx" aria-hidden="true"><span>[ ${l.p('/battle')} ]</span><span data-live="seed"></span></span>`);
const roster = battleRoster ? `${Object.entries(battleRoster.cost).map(([id, c]) => `${id}:${c}`).join(' ')} budget:${battleRoster.budget}` : null;
const jsonld = graph(page({ path: l.p('/'), type: 'CollectionPage', name: NAME, description: DESCRIPTION, image: `${SITE}/og/home.jpg`, mainEntity: { '@id': cardList['@id'] }, code }), cardList);
// a translated wall's lens and labels (src/lib/i18n-room.ts), one cached file between markup.js and gallery.js
const shim = l.en ? null : `${l.p('/gallery.js')}?v=${shimHash(galleryShim(code, fighters))}`;
---
<Base
  seo={{ title: NAME, fullTitle: l.en ? HOME_TITLE : undefined, description: l.en ? HOME_DESCRIPTION : DESCRIPTION, path: l.p('/'), og: 'home', imageAlt: l.t('home.imageAlt', { name: NAME, n: fighters.length }), jsonld }}
  room
  heavy
  main="gallery"
  scripts={roundScripts.filter((s) => s !== 'gallery.js')}
>
  <Fragment slot="head">
    <script is:inline>document.documentElement.dataset.hold = ''</script>
    <meta name="battle" content={l.p('/battle')} />
    {shim && <script is:inline defer src={shim}></script>}
    {roster && <meta name="battle-roster" content={roster} />}
    <script is:inline type="module" src={versioned('/sound/boot.gallery.js')}></script>
    <script is:inline defer src={versioned('/ex/gallery.js')}></script>
  </Fragment>
  <main class="gallery" id="gallery">
    <ul class="wall" aria-label={l.t('home.wall')} set:html={`${wall}\n<li class="pocket tile" data-far>${deck}</li>\n<li class="pocket tile" data-far>${pack}</li>`} />
    <script is:inline set:html={FRAMED} />
    <script is:inline set:html={EAGER} />
    <script is:inline>/* each card's plain link to its page stays a real link until the gallery's scripts have booted; once the card is the lens's button the link leaves the tab order and the accessibility tree, so no card is announced twice */addEventListener("DOMContentLoaded",function(){if(self.Gallery)document.querySelectorAll(".wall a.golink").forEach(function(a){a.tabIndex=-1;a.setAttribute("aria-hidden","true")})})</script>
    <script is:inline>/* the page shows once the pictures of the cards on screen are decoded (1 s at most), so it paints whole instead of card by card; every pocket is printed far (data-far, site.css), and the ones on screen are let near here, before the first frame; in the Machine view no picture shows, so it waits on none and fetches none ahead; the cards below load unseen, and the rest fetch at idle once the page has loaded (on a touch screen they stay lazy and load as they near the screen, so a phone holds only the pictures it has shown). At that idle one silent context is made and closed: the browser's first AudioContext waits on its audio service starting (seconds on a busy phone), and the sound kit makes its own in the visitor's first press, so that press no longer pays for it. Nothing plays and nothing is fetched (docs/sound.md) */(function(d){var vh=innerHeight,imgs=[],mx=d.dataset.mode==="machine";if(!mx)document.querySelectorAll(".wall > .pocket").forEach(function(p){var r=p.getBoundingClientRect();if(r.top<vh&&r.bottom>0){p.removeAttribute("data-far");p.querySelectorAll("img").forEach(function(i){imgs.push(i.decode().catch(function(){}))})}});Promise.race([Promise.all(imgs),new Promise(function(r){setTimeout(r,1000)})]).then(function(){delete d.dataset.hold});addEventListener("load",function(){(self.requestIdleCallback||setTimeout)(function(){if(!mx&&!matchMedia("(pointer: coarse)").matches)document.querySelectorAll('img[loading="lazy"]').forEach(function(i){i.loading="eager"});try{var k=localStorage.getItem("kevin-liu-studio:sound"),C=self.AudioContext||self.webkitAudioContext;if(C&&(k==="on"||k===null&&!matchMedia("(prefers-reduced-motion: reduce)").matches))new C().close()}catch(e){}})},{once:true})})(document.documentElement)</script>
    <script is:inline>/* a card more than a screen away drops its filters (the cracks' glow, the symbols' shadows, a cost 4 card's colour): WebKit keeps a device-size buffer for every filtered box it has painted, about 190 MB for the 26 cards on an iPhone. It takes them back a screen before it shows (site.css, docs/performance.md) */if("IntersectionObserver"in self){var far=new IntersectionObserver(function(es){es.forEach(function(e){e.target.toggleAttribute("data-far",!e.isIntersecting)})},{rootMargin:"100% 0px"});document.querySelectorAll(".wall > .pocket").forEach(function(p){far.observe(p)})}</script>
  </main>
  <Fragment set:html={dock} />
  <script is:inline>/* the Machine view's live parts: each well names the card it holds and the pack and Play the seed, as gallery.js's __table has them (the state the battle address carries, #team=a,b,c&rival=x,y,z&seed=N). They follow the dock's own changes */(function(){var d=document.querySelector('.dock');if(!d)return;function fill(){var t=self.__table;if(!t)return;var ws=d.querySelectorAll('.well');ws.forEach(function(w){var m=w.querySelector('[data-live="slot"]'),side=w.closest('.rival')?t.rival:t.you;if(m)m.textContent=side[+w.dataset.slot]||''});document.querySelectorAll('[data-live="seed"]').forEach(function(s){s.textContent=(s.closest('.play')?'seed=':'')+t.seed})}addEventListener('load',fill);if('MutationObserver'in self)new MutationObserver(fill).observe(d,{subtree:true,attributes:true,attributeFilter:['aria-label','data-state']})})()</script>
  <Fragment slot="overlay">
    <canvas id="world" aria-hidden="true"></canvas>
    <div class="stage" id="stage" aria-hidden="true"></div>
    <Fragment set:html={roomIn(M.inspect(), code)} />
    <p class="sr" role="status" id="status"></p>
  </Fragment>
</Base>
