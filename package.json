{
  "name": "kevinliu-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "dev": "astro dev",
    "build": "node scripts/lock-check.mjs && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check": "astro check && node scripts/verify-build.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:translate": "node scripts/i18n-extract.mjs && node --env-file=.env.local node_modules/gt/bin/main.js translate && node scripts/i18n-polish.mjs && node --env-file=.env.local node_modules/gt/bin/main.js save-local",
    "test": "node --test \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.3",
    "@astrojs/sitemap": "3.7.4",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "gt": "2.27.3",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "typescript": "^7.0.2"
  }
}
